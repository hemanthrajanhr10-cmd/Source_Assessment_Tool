# Copy to .env and adjust values. Never commit .env to source control.

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Directory where generated Excel reports are stored
REPORTS_DIR=reports

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Maximum tables sampled for null analysis (default 100)
MAX_NULL_ANALYSIS_TABLES=100

# ── OAuth SSO ────────────────────────────────────────────────────────────────
# Microsoft Entra ID — register at https://portal.azure.com
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT_ID=common
OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/microsoft/callback

# Google — register at https://console.cloud.google.com
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Apple Sign In — register Services ID at https://developer.apple.com
# Redirect URI must be HTTPS in production.
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
# Paste full .p8 key content (newlines as \n)
OAUTH_APPLE_PRIVATE_KEY=
OAUTH_APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/apple/callback

# Frontend base URL (used by backend to redirect after OAuth)
FRONTEND_URL=http://localhost:5173

# Backend base URL (used in admin email links — set to your Azure app URL in prod)
BACKEND_URL=http://localhost:8000

# ── Azure Communication Services — Email ──────────────────────────────────────
# 1. Azure Portal → Create "Communication Services" resource
# 2. Inside resource → Email → Domains → Add → Azure managed domain
# 3. Keys blade → copy Primary connection string
ACS_EMAIL_CONNECTION_STRING=endpoint=https://<resource>.communication.azure.com/;accesskey=<key>
ACS_EMAIL_SENDER=DoNotReply@<domain>.azurecomm.net
ADMIN_EMAIL=hemanth.rajan@ubtiinc.com
